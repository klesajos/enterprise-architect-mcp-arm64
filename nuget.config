<?xml version="1.0" encoding="utf-8"?>
<!-- Pin all NuGet resolution (the WiX local-tool restore and the apphost build's implicit
     restore) to nuget.org, regardless of user/machine-level feeds. <clear /> is the
     load-bearing part: without it a corporate/private feed could satisfy the 'wix'
     package id (package-source confusion). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
